NODE_ENV=development
PORT=9000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/app_db?replicaSet=rs0
REDIS_URL=redis://localhost:6379
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
INIT_SUPER_ADMIN_EMAIL=admin@mail.com
INIT_SUPER_ADMIN_USERNAME=Admin
INIT_SUPER_ADMIN_PASSWORD=Password1

# AI ordering assistant. All three are optional and the assistant stays OFF
# unless AI_ORDERING_VERSION_ID names a released version AND a key is present.
# A key on its own never routes guest traffic to the provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ORDERING_VERSION_ID=